<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/blanco">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_principal"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/titulo_calculadora"
            android:textColor="@color/blanco"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tipo de jornada -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tipo_jornada"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/grupoTipoJornada"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/radioNormal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/jornada_normal"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_texto_segmento"
                    android:background="@drawable/fondo_segmento_izquierdo"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioDura"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/jornada_dura"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_texto_segmento"
                    android:background="@drawable/fondo_segmento_derecho" />
            </RadioGroup>

            <!-- Horas trabajadas -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/horas_trabajadas"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnMenosHoras"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    style="@style/BotonPrincipal"
                    android:text="@string/btn_menos"
                    android:textSize="26sp"
                    android:contentDescription="@string/btn_menos" />

                <EditText
                    android:id="@+id/editHoras"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/fondo_campo_texto"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:maxLength="5"
                    android:textColor="@color/negro"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:text="8.0" />

                <Button
                    android:id="@+id/btnMasHoras"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    style="@style/BotonPrincipal"
                    android:text="@string/btn_mas"
                    android:textSize="26sp"
                    android:contentDescription="@string/btn_mas" />
            </LinearLayout>

            <TextView
                android:id="@+id/textoError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/rojo_error"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- Desglose -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/desglose"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/fondo_tarjeta"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextoValor"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/horas_base_label" />

                    <TextView
                        android:id="@+id/valorHorasBase"
                        style="@style/TextoValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        style="@style/TextoValor"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/horas_extra_label" />

                    <TextView
                        android:id="@+id/valorHorasExtra"
                        style="@style/TextoValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        style="@style/TextoValor"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/reconocimiento_label" />

                    <TextView
                        android:id="@+id/valorReconocimiento"
                        style="@style/TextoValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gris_borde"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextoEtiqueta"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/subtotal_label" />

                    <TextView
                        android:id="@+id/valorSubtotal"
                        style="@style/TextoEtiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/fondo_total"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_label"
                    android:textColor="@color/negro"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/valorTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/verde_oscuro"
                    android:textStyle="bold"
                    android:textSize="42sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCompartir"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                style="@style/BotonPrincipal"
                android:text="@string/btn_compartir"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnConfiguracion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    style="@style/BotonSecundario"
                    android:text="@string/btn_configuracion"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnManual"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    style="@style/BotonSecundario"
                    android:text="@string/btn_manual" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
